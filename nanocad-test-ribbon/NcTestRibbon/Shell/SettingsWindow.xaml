<Window x:Class="NcTestRibbon.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NcTestRibbon.Shell"
        Title="Настройки"
        Height="1100"
        Width="1300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <Button Content="Сохранить"
              Padding="22,7"
              IsDefault="True"
              Click="Save_Click"/>
      <Button Content="Отмена"
              Padding="22,7"
              Margin="8,0,0,0"
              IsCancel="True"/>
    </StackPanel>

    <TextBlock x:Name="TxtCacheInfo"
               DockPanel.Dock="Bottom"
               Margin="0,6,0,0"
               FontSize="11"
               Foreground="Gray"
               TextWrapping="Wrap"/>

    <TabControl x:Name="MainTabs">
      <TabItem Header="Настройки трассировки">
        <local:TracingSettingsPanel x:Name="TracingPanel"/>
      </TabItem>
      <TabItem Header="Траншея и дорога">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ContentControl x:Name="TrenchHost"/>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
