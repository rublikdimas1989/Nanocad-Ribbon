<Window x:Class="NcTestRibbon.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NcTestWpf — демо WPF"
        Height="220"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               FontSize="18"
               FontWeight="SemiBold"
               Text="Демо-окно WPF" />

    <TextBlock Grid.Row="1"
               Margin="0,12,0,0"
               TextWrapping="Wrap"
               Text="Простая отдельная форма nanoCAD-плагина. Команда NcTestWpf открывает это окно через Window.Show() (modeless — nanoCAD остаётся доступным)." />

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="OK / Закрыть"
              MinWidth="120"
              Padding="12,6"
              IsDefault="True"
              Click="CloseButton_Click" />
    </StackPanel>
  </Grid>
</Window>
