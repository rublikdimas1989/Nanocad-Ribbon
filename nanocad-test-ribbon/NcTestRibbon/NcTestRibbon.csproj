<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>10</LangVersion>
    <AssemblyName>NC_TestRibbon</AssemblyName>
    <RootNamespace>NcTestRibbon</RootNamespace>
    <!-- Product / File version. AssemblyVersion stays 1.0.0.0 for any remaining Page shells. -->
    <Version>1.2.45</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.2.45.0</FileVersion>
    <InformationalVersion>1.2.45+EcwEmbeddedGdal</InformationalVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableDefaultPageItems>true</EnableDefaultPageItems>
    <!-- Ensure NuGet deps (EPPlus + transitive) copy next to NC_TestRibbon.dll. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NcSdkDir Condition="'$(NcSdkDir)' == ''">C:\Users\bublik_da\YandexDisk\Автоматизация проектирования\Проекты\Паспотизация ИЗП\Инструменты nanocad\NC_SDK_RU_24.0.6388.4326.7145\</NcSdkDir>
  </PropertyGroup>

  <PropertyGroup>
    <NcSdkDir Condition="'$(NcSdkDir)' != '' and !HasTrailingSlash('$(NcSdkDir)')">$(NcSdkDir)\</NcSdkDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="hostdbmgd">
      <HintPath>$(NcSdkDir)include-x64\hostdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="hostmgd">
      <HintPath>$(NcSdkDir)include-x64\hostmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Windows.Controls.Ribbon" />
  </ItemGroup>

  <ItemGroup>
    <!-- End-variant Price.xlsx / Price.xlsm reader (InitialData / TopologyRates path). -->
    <PackageReference Include="EPPlus" Version="8.6.3">
      <PrivateAssets>none</PrivateAssets>
    </PackageReference>
    <!-- End-style ECW GeoTransform: Gdal.Open + GetGeoTransform (+ ECW plugin natives). -->
    <PackageReference Include="GDAL" Version="3.12.1">
      <PrivateAssets>none</PrivateAssets>
    </PackageReference>
    <PackageReference Include="GDAL.Native" Version="3.12.1">
      <PrivateAssets>none</PrivateAssets>
    </PackageReference>
    <PackageReference Include="GDAL.Plugins" Version="3.12.1">
      <PrivateAssets>none</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icons\*.ico">
      <LogicalName>NC_ICONS.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Loose XAML for Settings tracing tab — XamlReader, no pack/BAML URI. -->
    <EmbeddedResource Include="Shell\TracingSettingsPanel.xaml">
      <LogicalName>NcTestRibbon.Shell.Xaml.TracingSettingsPanel.xaml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Code-built / embedded shells (NOT Page code-behind):
      SettingsWindow.cs only
      TracingSettingsPanel.cs + TracingSettingsPanel.xaml (EmbeddedResource)
    Unzip-over-old leaves *.xaml.cs twins → CS0101/CS0111. Remove from compile + disk.
    Keep real Page pairs: MainWindow / ProfileControl / RatesPanel *.xaml.cs
  -->
  <ItemGroup>
    <Compile Remove="Shell\SettingsWindow.xaml.cs" />
    <Compile Remove="Shell\TracingSettingsPanel.xaml.cs" />
    <Compile Remove="Shell\InitialData.xaml.cs" />
    <Compile Remove="Shell\InitialData.cs" />
    <Compile Remove="Shell\PadOptimizationWindow.xaml.cs" />
    <Compile Remove="Shell\TrenchRoadSettingsPanel.xaml.cs" />
    <Compile Remove="Shell\TracingCache.xaml.cs" />
    <Compile Remove="Shell\ShellXaml.xaml.cs" />
    <Page Remove="Shell\SettingsWindow.xaml" />
    <Page Remove="Shell\TracingSettingsPanel.xaml" />
    <Page Remove="Shell\InitialData.xaml" />
    <Page Remove="Shell\PadOptimizationWindow.xaml" />
    <Page Remove="Shell\TrenchRoadSettingsPanel.xaml" />
    <None Remove="Shell\SettingsWindow.xaml" />
    <None Remove="Shell\InitialData.xaml" />
    <EmbeddedResource Remove="Shell\SettingsWindow.xaml" />
    <EmbeddedResource Remove="Shell\InitialData.xaml" />
    <ApplicationDefinition Remove="Shell\SettingsWindow.xaml" />
    <ApplicationDefinition Remove="Shell\TracingSettingsPanel.xaml" />
    <ApplicationDefinition Remove="Shell\InitialData.xaml" />
  </ItemGroup>

  <!-- Remaining Page shells (MainWindow still uses BAML). -->
  <ItemGroup>
    <Page Update="Shell\MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Shell\ProfileControl.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Shell\RatesPanel.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DemoWindow.cs" />
    <Compile Remove="DemoWindow.xaml.cs" />
    <Page Remove="DemoWindow.xaml" />
    <None Remove="DemoWindow.xaml" />
    <EmbeddedResource Remove="DemoWindow.xaml" />
    <ApplicationDefinition Remove="DemoWindow.xaml" />
  </ItemGroup>

  <!-- Delete leftover Shell files on disk before compile (unzip-over-old tree). -->
  <Target Name="DeleteLegacyShellDuplicates" BeforeTargets="BeforeBuild;CoreCompile">
    <ItemGroup>
      <_LegacyShell Include="$(MSBuildProjectDirectory)\Shell\SettingsWindow.xaml" />
      <_LegacyShell Include="$(MSBuildProjectDirectory)\Shell\SettingsWindow.xaml.cs" />
      <_LegacyShell Include="$(MSBuildProjectDirectory)\Shell\TracingSettingsPanel.xaml.cs" />
      <_LegacyShell Include="$(MSBuildProjectDirectory)\Shell\InitialData.xaml" />
      <_LegacyShell Include="$(MSBuildProjectDirectory)\Shell\InitialData.xaml.cs" />
      <_LegacyShell Include="$(MSBuildProjectDirectory)\Shell\InitialData.cs" />
      <_LegacyShell Include="$(MSBuildProjectDirectory)\Shell\PadOptimizationWindow.xaml" />
      <_LegacyShell Include="$(MSBuildProjectDirectory)\Shell\PadOptimizationWindow.xaml.cs" />
      <_LegacyShell Include="$(MSBuildProjectDirectory)\Shell\TrenchRoadSettingsPanel.xaml" />
      <_LegacyShell Include="$(MSBuildProjectDirectory)\Shell\TrenchRoadSettingsPanel.xaml.cs" />
      <_LegacyShell Include="$(MSBuildProjectDirectory)\DemoWindow.xaml" />
      <_LegacyShell Include="$(MSBuildProjectDirectory)\DemoWindow.xaml.cs" />
      <_LegacyShell Include="$(MSBuildProjectDirectory)\DemoWindow.cs" />
    </ItemGroup>
    <Delete Files="@(_LegacyShell)" TreatErrorsAsWarnings="true" />
  </Target>

  <Target Name="ValidateNcSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="!Exists('$(NcSdkDir)include-x64\hostmgd.dll')"
      Text="nanoCAD SDK not found: '$(NcSdkDir)include-x64\hostmgd.dll'. Edit Directory.Build.props or pass -p:NcSdkDir=..." />
  </Target>

  <!--
    Refresh installer\deps with NuGet lockfile assemblies so the release zip /
    INSTALL always ship EPPlus + gdal_csharp next to NC_TestRibbon.dll (nanoCAD LoadFile).
  -->
  <Target Name="SyncEpplusDepsToInstaller" AfterTargets="Build">
    <PropertyGroup>
      <_InstallerDepsDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\installer\deps'))</_InstallerDepsDir>
      <_InstallerGdalDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\installer\gdal'))</_InstallerGdalDir>
      <_NuGetGdalNative>$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)gdal.native\3.12.1\build\gdal'))</_NuGetGdalNative>
      <_NuGetGdalPlugins>$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)gdal.plugins\3.12.1\build\gdal'))</_NuGetGdalPlugins>
    </PropertyGroup>
    <ItemGroup>
      <_PluginDeps Include="$(TargetDir)*.dll"
                   Exclude="$(TargetDir)$(TargetName).dll;$(TargetDir)hostmgd.dll;$(TargetDir)hostdbmgd.dll" />
    </ItemGroup>
    <MakeDir Directories="$(_InstallerDepsDir)" />
    <Copy SourceFiles="@(_PluginDeps)" DestinationFolder="$(_InstallerDepsDir)" SkipUnchangedFiles="true" />
    <Message Importance="high"
             Text="Synced @(_PluginDeps->'%(Filename)%(Extension)') to installer\deps for packaging."
             Condition="'@(_PluginDeps)' != ''" />
    <!-- Refresh bundled GDAL x64 + ECW plugins when NuGet packages are present. -->
    <ItemGroup Condition="Exists('$(_NuGetGdalNative)\x64\gdal_wrap.dll')">
      <_GdalNativeX64 Include="$(_NuGetGdalNative)\x64\**\*.*" />
      <_GdalData Include="$(_NuGetGdalNative)\data\**\*.*" Condition="Exists('$(_NuGetGdalNative)\data')" />
      <_GdalShare Include="$(_NuGetGdalNative)\share\**\*.*" Condition="Exists('$(_NuGetGdalNative)\share')" />
    </ItemGroup>
    <ItemGroup Condition="Exists('$(_NuGetGdalPlugins)\x64\plugins\gdal_ECW_JP2ECW.dll')">
      <_GdalPluginsX64 Include="$(_NuGetGdalPlugins)\x64\plugins\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(_InstallerGdalDir)\x64;$(_InstallerGdalDir)\x64\plugins;$(_InstallerGdalDir)\data;$(_InstallerGdalDir)\share"
             Condition="'@(_GdalNativeX64)' != ''" />
    <Copy SourceFiles="@(_GdalNativeX64)"
          DestinationFolder="$(_InstallerGdalDir)\x64\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_GdalNativeX64)' != ''" />
    <Copy SourceFiles="@(_GdalPluginsX64)"
          DestinationFolder="$(_InstallerGdalDir)\x64\plugins\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_GdalPluginsX64)' != ''" />
    <Copy SourceFiles="@(_GdalData)"
          DestinationFolder="$(_InstallerGdalDir)\data\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_GdalData)' != ''" />
    <Copy SourceFiles="@(_GdalShare)"
          DestinationFolder="$(_InstallerGdalDir)\share\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_GdalShare)' != ''" />
    <Message Importance="high"
             Text="Synced GDAL x64 + ECW plugins to installer\gdal."
             Condition="'@(_GdalNativeX64)' != ''" />
  </Target>

</Project>
