<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>10</LangVersion>
    <AssemblyName>NcBootstrap</AssemblyName>
    <RootNamespace>NcBootstrap</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.2.87</Version>
    <FileVersion>1.2.87.0</FileVersion>
    <InformationalVersion>1.2.87+BazaTypicalTabs</InformationalVersion>
    <NcSdkDir Condition="'$(NcSdkDir)' == ''">C:\Users\bublik_da\YandexDisk\Автоматизация проектирования\Проекты\Паспотизация ИЗП\Инструменты nanocad\NC_SDK_RU_24.0.6388.4326.7145\</NcSdkDir>
  </PropertyGroup>

  <PropertyGroup>
    <NcSdkDir Condition="'$(NcSdkDir)' != '' and !HasTrailingSlash('$(NcSdkDir)')">$(NcSdkDir)\</NcSdkDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="hostdbmgd">
      <HintPath>$(NcSdkDir)include-x64\hostdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="hostmgd">
      <HintPath>$(NcSdkDir)include-x64\hostmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EnsureNcSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="!Exists('$(NcSdkDir)include-x64\hostmgd.dll')"
      Text="nanoCAD SDK not found: '$(NcSdkDir)include-x64\hostmgd.dll'. Pass -p:NcSdkDir=..." />
  </Target>

</Project>
